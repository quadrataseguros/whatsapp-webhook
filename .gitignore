segredo.txt
instagram.txt
token-curto.txt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional
.DS_Store

# Banco de dados local (painel de metas)
*.db
*.db-shm
*.db-wal

# Documentos de clientes (propostas, apolices) — nunca versionar
*.pdf
*.PDF

# Tela de design montada (saida de build, ~2,4 MB)
marca/**/logotipo-*.html
