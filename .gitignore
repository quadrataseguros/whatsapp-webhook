# Dependências (reinstaladas no deploy)
node_modules/

# Variáveis de ambiente (segredos — nunca versionar)
.env
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional
.DS_Store

# Imagens de posts colocadas em ./media na hora de publicar (não versionar).
