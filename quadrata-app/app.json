{
  "expo": {
    "name": "Quadrata App",
    "slug": "quadrata-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "quadrataapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./public/icon-1024.png",
    "splash": { "backgroundColor": "#0D2B6E", "resizeMode": "contain" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quadrataseguros.app"
    },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./public/icon-1024.png", "backgroundColor": "#0D2B6E" },
      "package": "com.quadrataseguros.app",
      "versionCode": 1
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./public/favicon.png" },
    "experiments": { "baseUrl": "/quadrata" },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
