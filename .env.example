# WhatsApp Business API
VERIFY_TOKEN=quadrata123
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Versão da Graph API da Meta (padrão v21.0). Atualize se a Meta descontinuar.
GRAPH_VERSION=v21.0
# Id do App no painel developers.facebook.com. Só é usado para subir a foto do
# perfil comercial do WhatsApp (rota /admin/whatsapp). Não é segredo.
META_APP_ID=

# IA das personas (MarIAna e FabrícIO) — API da Anthropic (Claude). Crie a
# chave em console.anthropic.com. Sem servidor separado ligado: paga-se só por
# mensagem processada.
ANTHROPIC_API_KEY=
# Modelo (padrão: Claude Haiku, rápido e econômico para atendimento)
MARIANA_MODEL=claude-haiku-4-5

# Instagram de cada persona (Graph API). É a conta em que o direct cai que
# decide quem responde. Sem essas variáveis a persona ainda atende no WhatsApp,
# só não responde no Instagram.
# MarIAna:
IG_USER_ID=
IG_ACCESS_TOKEN=
# FabrícIO:
IG_USER_ID_FABRICIO=
IG_ACCESS_TOKEN_FABRICIO=

# Make (fallback — só usado se ANTHROPIC_API_KEY não estiver configurada)
MAKE_WEBHOOK_URL=

# Espelho das conversas no Telegram (monitoramento pelo time).
# TELEGRAM_BOT_TOKEN: token do bot, criado no @BotFather (é como uma senha).
# TELEGRAM_CHAT_ID: id do grupo/conversa onde as mensagens devem aparecer
# (para grupos costuma ser um número negativo, ex.: -1001234567890).
# Deixe ambos em branco para desativar o espelho.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional. Troca o número do WhatsApp usado pelos links /fale (bio dos dois
# Instagram — é o mesmo número para as duas personas).
# Padrão do código: (11) 98678-0000. Pode escrever com ou sem máscara/DDI.
WHATSAPP_NUMERO=

# Agradecimentos do sorteio (/agradecimentos). A lista de participantes vem do
# Supabase do sorteio-fianca; sem essas duas a página não carrega ninguém.
SUPABASE_URL=
SUPABASE_KEY=
# Template aprovado em Meta Business > WhatsApp > Modelos de mensagem. O corpo
# precisa ter um único parâmetro {{1}}, que recebe o primeiro nome da pessoa.
# A Meta exige template para iniciar conversa com quem não escreveu para a
# gente nas últimas 24h — em texto livre a API recusa com o erro 131047.
AGRADECIMENTO_TEMPLATE=agradecimento_evento
AGRADECIMENTO_TEMPLATE_LANG=pt_BR
# Só use "texto" se a lista for de gente que respondeu nas últimas 24h.
AGRADECIMENTO_MODO=template
# Intervalo entre um envio e outro, em milissegundos.
AGRADECIMENTO_INTERVALO_MS=1000

PORT=3000

# Painel de Metas — senha do administrador
ADMIN_PASSWORD=admin123
