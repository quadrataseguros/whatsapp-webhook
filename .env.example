# WhatsApp Business API
VERIFY_TOKEN=quadrata123
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Versão da Graph API da Meta (padrão v21.0). Atualize se a Meta descontinuar.
GRAPH_VERSION=v21.0

# IA da MarIAna — API da Anthropic (Claude). Crie a chave em console.anthropic.com.
# Sem servidor separado ligado: paga-se só por mensagem processada.
ANTHROPIC_API_KEY=
# Modelo (padrão: Claude Haiku, rápido e econômico para atendimento)
MARIANA_MODEL=claude-haiku-4-5

# Make (fallback — só usado se ANTHROPIC_API_KEY não estiver configurada)
MAKE_WEBHOOK_URL=

# --- Publicação no feed do Instagram (posts e carrosséis) ---
# Protege o endpoint POST /instagram/publish. Sem ADMIN_TOKEN o endpoint fica
# DESATIVADO. Use um valor secreto e forte.
ADMIN_TOKEN=
# URL pública do próprio servidor, usada para servir imagens locais de ./media
# como URL que a Meta consegue ler (ex.: https://webhook.quadratadigital.com.br).
PUBLIC_BASE_URL=
# Credenciais de publicação. Se vazias, o módulo reutiliza IG_USER_ID e
# IG_ACCESS_TOKEN (os mesmos dos DMs). A conta precisa ser Business/Creator e
# o token ter a permissão instagram_content_publish.
IG_PUBLISH_USER_ID=
IG_PUBLISH_TOKEN=
# Host da Graph API para publicação (padrão graph.instagram.com, igual aos DMs).
# Se sua conta publica via Facebook Login, use graph.facebook.com.
IG_GRAPH_HOST=graph.instagram.com

# Espelho das conversas no Telegram (monitoramento pelo time).
# TELEGRAM_BOT_TOKEN: token do bot, criado no @BotFather (é como uma senha).
# TELEGRAM_CHAT_ID: id do grupo/conversa onde as mensagens devem aparecer
# (para grupos costuma ser um número negativo, ex.: -1001234567890).
# Deixe ambos em branco para desativar o espelho.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000
